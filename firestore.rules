rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email == 'kai0430xx@gmail.com'; }
  match /calendars/{uid}/categories/{id} {
   allow read: if member(uid);
   allow create, update: if member(uid)
    && request.resource.data.keys().hasOnly(['id','name','color'])
    && request.resource.data.id == id
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
    && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$');
   allow delete: if member(uid);
  }
  match /calendars/{uid}/events/{id} {
   allow read: if member(uid);
   allow create, update: if member(uid)
    && request.resource.data.keys().hasAll(['id','title','date','start','end','allDay','category','notes'])
    && request.resource.data.keys().hasOnly(['id','title','date','start','end','allDay','category','notes'])
    && request.resource.data.id == id
    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && request.resource.data.start is string && request.resource.data.end is string
    && request.resource.data.allDay is bool
    && (request.resource.data.allDay || (request.resource.data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && (request.resource.data.end == '' || (request.resource.data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && request.resource.data.end > request.resource.data.start))))
    && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
    && request.resource.data.category is string
    && exists(/databases/$(database)/documents/calendars/$(uid)/categories/$(request.resource.data.category));
   allow delete: if member(uid);
  }
 }
}
